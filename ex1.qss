QMainWindow {
    background-color: #f5f7f0;
}

#centralWidget {
    background-color: #f5f7f0;
}

#pageTitle {
    color: #61263c;
    font-size: 27px;
    font-weight: 700;
}

#pageSubtitle {
    color: #59645d;
    font-size: 14px;
    margin-top: 0px;
}

QPushButton {
    min-height: 40px;
    padding: 0 18px;
    border: 1px solid transparent;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
}

#chooseButton {
    color: #263d31;
    background-color: #f2df91;
}

#chooseButton:hover {
    background-color: #c7e2f2;
}

#updateButton,
#updateGradeButton {
    color: #4a3912;
    background-color: #f2df91;
    border: 2px solid #61263c;
}

#updateButton:hover,
#updateGradeButton:hover {
    background-color:  #c7e2f2;
}

#aboutButton {
    color: #25445d;
    background-color: #c7e2f2;
}

#aboutButton:hover {
    background-color: #b1d5eb;
}

QPushButton:focus {
    border: 2px solid #61263c;
}

#gradesTable {
    background-color: #ffffff;
    alternate-background-color: #f4f8ef;
    color: #28332d;
    border: 1px solid #61263c;
    border-radius: 10px;
    selection-background-color: #61263c;
    selection-color: #ffffff;
    font-size: 14px;
}

#gradesTable::item {
    padding: 7px 12px;
    border-bottom: 1px solid #61263c;
}

#gradesTable::item:selected {
    background-color: #61263c;
    color: #ffffff;
}

QHeaderView::section {
    background-color: #d9e8ca;
    color: #344638;
    padding: 12px;
    border: none;
    border-bottom: 2px solid #61263c;
    font-size: 13px;
    font-weight: 700;
}

#tableFooter {
    color: #69756c;
    font-size: 12px;
}

#updateGradeDialog {
    background-color: #f5f7f0;
}

#updateGradeFieldLabel {
    color: #344638;
    font-size: 13px;
    font-weight: 700;
}

#studentIdInput,
#scoreInput {
    min-height: 42px;
    padding: 0 12px;
    color: #28332d;
    background-color: #ffffff;
    border: 1px solid #a4ad9e;
    border-radius: 8px;
    font-size: 14px;
}

#studentIdInput:focus,
#scoreInput:focus {
    border: 2px solid #61263c;
}

#studentIdInput::drop-down {
    width: 32px;
    border-left: 1px solid #d1d8cd;
    background-color: #d9e8ca;
}

#studentIdList {
    color: #28332d;
    background-color: #ffffff;
    border: 1px solid #61263c;
    outline: none;
}

#studentIdList::item {
    min-height: 32px;
    padding: 6px 10px;
}

#studentIdList::item:selected,
#studentIdList::item:hover {
    color: #ffffff;
    background-color: #61263c;
}

#scoreInput::up-button,
#scoreInput::down-button {
    width: 24px;
    border: none;
    background-color: #d9e8ca;
}

#submitGradeButton {
    min-height: 44px;
    margin-top: 6px;
    color: #ffffff;
    background-color: #61263c;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
}

#submitGradeButton:hover {
    background-color: #7a354f;
}

#submitGradeButton:pressed {
    background-color: #4d1d30;
}

#aboutWindow {
    background-color: #f5f7f0;
}

#aboutName {
    color: #61263c;
    font-size: 24px;
    font-weight: 700;
}

#aboutEmail {
    color: #59645d;
    font-size: 14px;
}

#aboutPicture {
    background-color: #ffffff;
    border: 1px solid #d9e8ca;
    border-radius: 10px;
}
